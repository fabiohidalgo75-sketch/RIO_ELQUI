# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Mismo puerto que la documentación (en EcoPoint había 3001 vs 3000)
PORT=3000
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081

# ─── Database (PostGIS) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://elquialerta:elquialerta_secret@localhost:5433/elquialerta?schema=public

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380

# ─── MinIO (fotos de reportes) ───────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=elquialerta_minio
MINIO_SECRET_KEY=elquialerta_minio_secret
MINIO_BUCKET=elquialerta

# ─── Notificaciones ──────────────────────────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Proveedor SMS de respaldo (pendiente de elegir)
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

# ─── Alertas ─────────────────────────────────────────────────────────────────
# Minutos sin confirmación antes de pasar a la lista de brigadas
ACK_TIMEOUT_MINUTES=15

# ─── Seed (primer arranque) ──────────────────────────────────────────────────
SEED_OPERATOR_EMAIL=operador@elquialerta.local
SEED_OPERATOR_PASSWORD=CambiarEsto123!
SEED_OPERATOR_NAME=Centro de Monitoreo Vicuña
